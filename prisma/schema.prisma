model UserSession {
  id         String    @id @default(cuid())
  userId     String
  sessionId  String    @unique
  ipAddress  String?
  userAgent  String?
  city       String?
  country    String?
  isActive   Boolean   @default(true)
  lastSeenAt DateTime  @default(now())
  createdAt  DateTime  @default(now())
  expiresAt  DateTime?

  @@index([userId])
  @@index([sessionId])
  @@index([isActive])
}

// ====================== ONBOARDING ======================

model OnboardingProgress {
  id          String    @id @default(cuid())
  userId      String    @unique
  env         String    @default("pf") // pf or pj
  currentStep Int       @default(0)
  completedAt DateTime?
  stepsData   Json?     @default("{}")
  dismissed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

// ====================== MULTI-CURRENCY ======================

model Currency {
  id        String         @id @default(cuid())
  code      String         @unique // BRL, USD, EUR, etc.
  name      String
  symbol    String
  isBase    Boolean        @default(false)
  isActive  Boolean        @default(true)
  createdAt DateTime       @default(now())
  rates     ExchangeRate[] @relation("CurrencyRates")
}

model ExchangeRate {
  id           String   @id @default(cuid())
  fromCurrency String // e.g. USD
  toCurrency   String   @default("BRL")
  rate         Float
  source       String? // api provider name
  date         DateTime @default(now())
  currency     Currency @relation("CurrencyRates", fields: [fromCurrency], references: [code], onDelete: Cascade)

  @@index([fromCurrency, toCurrency])
  @@index([date])
}

// ====================== NF-e (NOTA FISCAL) ======================

model NFe {
  id               String             @id @default(cuid())
  companyId        String
  company          Company            @relation("CompanyNFes", fields: [companyId], references: [id], onDelete: Cascade)
  receivableId     String? // link to AccountsReceivable
  number           String?
  series           String?            @default("1")
  type             String             @default("nfe") // nfe, nfse, nfce
  status           String             @default("rascunho") // rascunho, enviada, autorizada, cancelada, rejeitada
  environment      String             @default("producao") // homologacao, producao
  customerName     String?
  customerDoc      String? // CPF or CNPJ
  customerEmail    String?
  customerAddress  String?
  items            Json? // array of NF items
  totals           Json? // totalProdutos, totalImpostos, totalNota
  paymentMethod    String?
  observations     String?
  fiscalRuleId     String?
  fiscalRule       ServiceFiscalRule? @relation("NFeFiscalRule", fields: [fiscalRuleId], references: [id], onDelete: SetNull)
  taxSnapshot      Json?
  validationStatus String             @default("pending") // pending, valid, blocked
  validationErrors Json?
  providerKey      String? // which NF provider (nfe_io, focusnfe, etc.)
  providerNFeId    String? // external NF-e ID
  accessKey        String? // chave de acesso (44 chars)
  xmlUrl           String?
  pdfUrl           String? // DANFE URL
  errorMessage     String?            @db.Text
  cancelReason     String?
  issuedAt         DateTime?
  canceledAt       DateTime?
  createdBy        String?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([receivableId])
  @@index([fiscalRuleId])
  @@index([accessKey])
}

// ====================== BOLETO / PIX COBRANÇA ======================

model BoletoCharge {
  id               String    @id @default(cuid())
  companyId        String
  company          Company   @relation("CompanyBoletos", fields: [companyId], references: [id], onDelete: Cascade)
  receivableId     String?
  type             String    @default("boleto") // boleto, pix
  status           String    @default("pendente") // pendente, pago, vencido, cancelado
  customerName     String
  customerDoc      String?
  customerEmail    String?
  amount           Float
  dueDate          DateTime
  description      String?
  instructions     String?
  providerKey      String? // asaas, iugu, gerencianet
  providerChargeId String? // external charge ID
  boletoBarCode    String?
  boletoUrl        String? // boleto PDF URL
  pixCopiaECola    String?   @db.Text // PIX copia e cola string
  pixQrCodeUrl     String? // PIX QR code image URL
  pixExpiresAt     DateTime?
  paidAt           DateTime?
  paidAmount       Float?
  createdBy        String?
  idempotencyKey   String?   @unique // client-provided Idempotency-Key (prevents double charge)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([receivableId])
  @@index([dueDate])
}

// Registro de eventos de webhook recebidos (idempotência + auditoria)
// Garante que reenvios do provedor (Asaas, Focus NFe, Pluggy) não dupliquem efeitos.
model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String // asaas, focusnfe, pluggy, whatsapp
  eventId     String // ID único do evento no provedor (ou hash do payload)
  eventType   String? // PAYMENT_RECEIVED, nfe_autorizada, etc.
  payload     Json?
  processedAt DateTime @default(now())

  @@unique([provider, eventId])
  @@index([provider, processedAt])
}

// ====================== MÓDULO FISCAL ======================

model ServiceFiscalRule {
  id                            String               @id @default(cuid())
  companyId                     String
  company                       Company              @relation("CompanyServiceFiscalRules", fields: [companyId], references: [id], onDelete: Cascade)
  name                          String
  serviceDescription            String?
  serviceCodeLc116              String
  cnae                          String?
  providerMunicipalRegistration String?
  providerCityCode              String
  providerCityName              String?
  customerCityCode              String?
  customerCityName              String?
  operationNature               String
  taxRegime                     String
  isSimplesNacional             Boolean              @default(true)
  issRate                       Float
  issWithheld                   Boolean              @default(false)
  inssRate                      Float                @default(0)
  irrfRate                      Float                @default(0)
  csllRate                      Float                @default(0)
  pisRate                       Float                @default(0)
  cofinsRate                    Float                @default(0)
  cbsRate                       Float                @default(0)
  ibsRate                       Float                @default(0)
  cbsCst                        String?
  ibsCst                        String?
  cbsClassificationCode         String?
  ibsClassificationCode         String?
  effectiveFrom                 DateTime?
  effectiveTo                   DateTime?
  isDefault                     Boolean              @default(false)
  isActive                      Boolean              @default(true)
  notes                         String?              @db.Text
  createdBy                     String?
  createdAt                     DateTime             @default(now())
  updatedAt                     DateTime             @updatedAt
  receivables                   AccountsReceivable[] @relation("ReceivableFiscalRule")
  contracts                     Contract[]           @relation("ContractFiscalRule")
  nfes                          NFe[]                @relation("NFeFiscalRule")

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@index([companyId, isDefault])
  @@map("regras_fiscais_servico")
}

model TaxRecord {
  id         String    @id @default(cuid())
  userId     String? // PF
  companyId  String? // PJ
  type       String // DAS, IRPF, CARNE_LEAO, ICMS, ISS, PIS, COFINS, FGTS
  period     String // YYYY-MM
  year       Int
  month      Int?
  baseValue  Float // base de cálculo
  taxValue   Float // valor do imposto
  rate       Float? // alíquota
  status     String    @default("aberto") // aberto, pago, vencido, dispensado
  dueDate    DateTime?
  paidAt     DateTime?
  paidAmount Float?
  barCode    String?
  receiptUrl String?
  notes      String?
  metadata   Json? // extra: anexos, DAS number, etc.
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  Company    Company?  @relation(fields: [companyId], references: [id])

  @@index([userId])
  @@index([companyId])
  @@index([type])
  @@index([period])
  @@index([status])
}

// ====================== CARNÊ-LEÃO PF ======================

model CarneLeaoEntry {
  id          String    @id @default(cuid())
  userId      String
  period      String // YYYY-MM
  year        Int
  month       Int
  incomeType  String // autonomo, alugueis, exterior, outros
  sourceName  String // nome do pagador
  sourceDoc   String? // CPF/CNPJ do pagador
  grossAmount Float // valor bruto recebido
  deductions  Float     @default(0) // deduções permitidas
  netAmount   Float // base de cálculo
  taxAmount   Float // imposto calculado
  rate        Float // alíquota aplicada
  paidAt      DateTime?
  notes       String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([userId])
  @@index([period])
  @@index([year, month])
}

// ====================== COMPRAS (PEDIDOS DE COMPRA) ======================

model PurchaseOrder {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation("CompanyPurchaseOrders", fields: [companyId], references: [id], onDelete: Cascade)
  supplierId   String?
  supplierName String
  number       String
  status       String    @default("rascunho") // rascunho, aprovado, parcial, recebido, cancelado
  orderDate    DateTime  @default(now())
  expectedDate DateTime?
  receivedDate DateTime?
  subtotal     Float     @default(0)
  discount     Float     @default(0)
  taxes        Float     @default(0)
  total        Float     @default(0)
  notes        String?   @db.Text
  items        Json?
  payableId    String?
  createdBy    String?
  approvedBy   String?
  approvedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([supplierId])
  @@index([orderDate])
}

// ====================== CONTRATOS ======================

model Contract {
  id                String             @id @default(cuid())
  companyId         String
  company           Company            @relation("CompanyContracts", fields: [companyId], references: [id], onDelete: Cascade)
  clientId          String?
  clientName        String
  clientDoc         String? // CPF/CNPJ para NF-e
  clientEmail       String?
  title             String
  type              String             @default("servico") // servico, locacao, manutencao, assinatura, fornecimento, outro
  status            String             @default("ativo") // rascunho, ativo, suspenso, encerrado, renovado
  value             Float
  categoryId        String?
  category          BusinessCategory?  @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  costCenterId      String?
  costCenter        CostCenter?        @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  billingCycle      String             @default("mensal") // mensal, trimestral, semestral, anual, unico, sob_demanda
  startDate         DateTime
  endDate           DateTime?
  renewalDate       DateTime?
  noticeDays        Int                @default(30)
  autoRenew         Boolean            @default(false)
  requiresNFe       Boolean            @default(false) // gera NF-e em cada faturamento
  requiresBoleto    Boolean            @default(false) // gera boleto/PIX em cada faturamento
  billingDay        Int?
  chargeType        String             @default("boleto_pix") // boleto, pix, boleto_pix, link
  fiscalRuleId      String?
  fiscalRule        ServiceFiscalRule? @relation("ContractFiscalRule", fields: [fiscalRuleId], references: [id], onDelete: SetNull)
  autoSendEmail     Boolean            @default(false)
  autoSendWhatsapp  Boolean            @default(false)
  nextBillingDate   DateTime?
  lastBilledAt      DateTime?
  description       String?            @db.Text
  terms             String?            @db.Text
  signedAt          DateTime?
  terminatedAt      DateTime?
  terminationReason String?
  attachmentUrl     String?
  createdBy         String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([clientId])
  @@index([renewalDate])
  @@index([categoryId])
  @@index([costCenterId])
  @@index([nextBillingDate])
  @@index([fiscalRuleId])
}

// ====================== WHATSAPP ======================

model WhatsappSession {
  id              String            @id @default(cuid())
  userId          String?
  companyId       String?
  provider        String            @default("evolution") // evolution, meta
  phoneNumber     String?
  instanceName    String? // Evolution API instance name
  apiUrl          String? // Evolution API base URL
  apiKey          String? // encrypted
  accessToken     String? // Meta Cloud API token (encrypted)
  phoneNumberId   String? // Meta phone number ID
  webhookToken    String? // token to verify incoming webhooks
  isActive        Boolean           @default(false)
  status          String            @default("disconnected") // connected, disconnected, qr_pending
  qrCode          String?           @db.Text
  lastConnectedAt DateTime?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  messages        WhatsappMessage[]

  @@index([userId])
  @@index([companyId])
}

model WhatsappMessage {
  id             String          @id @default(cuid())
  sessionId      String
  session        WhatsappSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  direction      String // inbound, outbound
  from           String
  to             String
  body           String?         @db.Text
  mediaUrl       String?
  mediaType      String? // image, document, audio
  templateName   String? // Meta template used
  templateParams Json? // template variable values
  contextType    String? // bill_reminder, payment_confirm, nfse, boleto, pix, overdue
  contextId      String? // AccountsPayable.id or AccountsReceivable.id or NFe.id
  externalMsgId  String? // Meta message_id for webhook tracking
  deliveryStatus String          @default("pending") // pending, sent, delivered, read, failed
  errorMessage   String?
  processed      Boolean         @default(false)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([sessionId])
  @@index([contextId])
  @@index([from])
  @@index([deliveryStatus])
  @@index([externalMsgId])
}

// ====================== TEMPLATES DE LANÇAMENTO ======================

model LancamentoTemplate {
  id           String   @id @default(cuid())
  companyId    String?
  userId       String?
  type         String // receivable, payable
  name         String
  description  String
  amount       Float?
  categoryId   String?
  costCenterId String?
  dayOfMonth   Int? // dia do mês para vencimento
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId])
  @@index([userId])
}

// ====================== SMTP ======================

model SmtpConfig {
  id            String     @id @default(cuid())
  companyId     String
  name          String     // label e.g. "Gmail Principal"
  preset        String     @default("custom") // gmail, outlook, zoho, locaweb, hostinger, custom
  senderName    String
  senderEmail   String
  host          String
  port          Int        @default(587)
  encryption    String     @default("tls") // none, ssl, tls
  encryptedPass String     // AES-256-GCM encrypted
  isDefault     Boolean    @default(false)
  isActive      Boolean    @default(true)
  lastTestedAt  DateTime?
  lastTestOk    Boolean?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  logs          EmailLog[]
  queue         EmailQueue[]

  @@index([companyId])
  @@index([isDefault])
}

model EmailLog {
  id           String      @id @default(cuid())
  companyId    String
  smtpConfigId String?
  smtpConfig   SmtpConfig? @relation(fields: [smtpConfigId], references: [id], onDelete: SetNull)
  to           String
  subject      String
  contextType  String? // nfse, boleto, pix, recibo, cobranca, test
  contextId    String?
  status       String      @default("sent") // sent, failed
  errorMsg     String?     @db.Text
  sentAt       DateTime    @default(now())
  createdAt    DateTime    @default(now())

  @@index([companyId])
  @@index([status])
  @@index([createdAt])
  @@index([smtpConfigId])
}

model EmailQueue {
  id           String      @id @default(cuid())
  companyId    String
  smtpConfigId String?
  smtpConfig   SmtpConfig? @relation(fields: [smtpConfigId], references: [id], onDelete: SetNull)
  to           String
  subject      String
  htmlBody     String?     @db.Text
  textBody     String?     @db.Text
  attachments  Json? // [{filename: string, url: string}]
  contextType  String? // nfse, boleto, pix, recibo, cobranca
  contextId    String?
  priority     Int         @default(5) // 1=high 5=normal 10=low
  status       String      @default("pending") // pending, processing, sent, failed
  retries      Int         @default(0)
  maxRetries   Int         @default(3)
  nextRetryAt  DateTime?
  sentAt       DateTime?
  errorMsg     String?     @db.Text
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([nextRetryAt])
  @@index([smtpConfigId])
}

// ============================================================
// Aprovação Financeira
// ============================================================
model FinancialApproval {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  type        String   // "expense" | "income" | "compra"
  referenceId String
  requesterId String
  requester   User     @relation("ApprovalRequester", fields: [requesterId], references: [id])
  approverId  String?
  approver    User?    @relation("ApprovalApprover", fields: [approverId], references: [id])
  status      String   @default("pending") // pending, approved, rejected
  notes       String?
  amount      Float
  description String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([status])
}

// ============================================================
// Régua de Cobrança
// ============================================================
model CollectionRule {
  id        String   @id @default(cuid())
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name      String
  isActive  Boolean  @default(true)
  // triggers: [{type: "before"|"on"|"after", days: number, channels: ["email","whatsapp"], template: string}]
  triggers  Json
  sentLogs  CollectionRuleLog[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([companyId])
}

model CollectionRuleLog {
  id               String         @id @default(cuid())
  collectionRuleId String
  collectionRule   CollectionRule @relation(fields: [collectionRuleId], references: [id], onDelete: Cascade)
  receivableId     String
  channel          String         // email | whatsapp
  triggerType      String         // before | on | after
  triggerDays      Int
  sentAt           DateTime       @default(now())

  @@unique([collectionRuleId, receivableId, channel, triggerType, triggerDays])
  @@index([collectionRuleId])
  @@index([receivableId])
}

// ============================================================
// NF-e Recebidas (SEFAZ)
// ============================================================
// ============================================================
// BPM Flow
// ============================================================
model BPMFlow {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation("CompanyBPMFlows", fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  description String?
  isActive    Boolean  @default(true)
  nodes       Json     // ReactFlow nodes
  edges       Json     // ReactFlow edges
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
}

// ============================================================
// CRM Automations
// ============================================================
model CRMAutomation {
  id          String   @id @default(cuid())
  companyId   String
  company     Company  @relation("CompanyCRMAutomations", fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  isActive    Boolean  @default(true)
  trigger     String   // new_client, new_receivable, payment_received, overdue, contract_expiring
  conditions  Json?    // [{field, operator, value}]
  actions     Json     // [{type: email|whatsapp|tag|task, ...}]
  lastRunAt   DateTime?
  runCount    Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([companyId])
  @@index([trigger])
}

// ============================================================
// Previsão Orçamentária (Budget Forecast)
// ============================================================
model BudgetForecast {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation("CompanyBudgets", fields: [companyId], references: [id], onDelete: Cascade)
  categoryId    String?
  category      BusinessCategory? @relation("CategoryBudgets", fields: [categoryId], references: [id], onDelete: SetNull)
  type          String            // receita | despesa
  period        String            // YYYY-MM
  plannedAmount Float
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([companyId, categoryId, period, type])
  @@index([companyId])
  @@index([period])
}

// ============================================================
// Negociação de Inadimplência (DebtNegotiation)
// ============================================================
model DebtNegotiation {
  id               String    @id @default(cuid())
  companyId        String
  company          Company   @relation("CompanyDebtNegotiations", fields: [companyId], references: [id], onDelete: Cascade)
  clientId         String?
  client           Client?   @relation(fields: [clientId], references: [id], onDelete: SetNull)
  receivableId     String?
  userId           String
  user             User      @relation("UserDebtNegotiations", fields: [userId], references: [id])
  type             String    // renegotiated | lost | not_negotiated | scheduled_call | note
  nextContactAt    DateTime?
  forecastDate     DateTime?
  penalty          Float?    @default(0)
  interest         Float?    @default(0)
  discount         Float?    @default(0)
  totalAmount      Float?
  paymentMethod    String?   // boleto | pix | deposito
  bankConnectionId String?
  notes            String?   @db.Text
  emailSentAt      DateTime?
  boletoCopiedAt   DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([companyId])
  @@index([clientId])
  @@index([receivableId])
}

model ReceivedNFe {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation("CompanyReceivedNFes", fields: [companyId], references: [id], onDelete: Cascade)
  accessKey     String
  number        String?
  series        String?
  supplierName  String?
  supplierCnpj  String?
  issueDate     DateTime?
  totalValue    Float?
  status        String   @default("valida") // valida, cancelada, denegada
  items         Json?
  xmlContent    String?  @db.Text
  notes         String?
  payableId     String?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([companyId, accessKey])
  @@index([companyId])
  @@index([issueDate])
  @@index([supplierCnpj])
}

// ====================== CUSTOM FIELDS ======================

model CustomField {
  id          String             @id @default(cuid())
  companyId   String
  company     Company            @relation("CompanyCustomFields", fields: [companyId], references: [id], onDelete: Cascade)
  entity      String             // client, payable, receivable, product
  name        String
  fieldKey    String             // snake_case key for programmatic use
  fieldType   String             @default("text") // text, number, date, boolean, select
  options     Json?              // for fieldType=select: array of string options
  required    Boolean            @default(false)
  order       Int                @default(0)
  isActive    Boolean            @default(true)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt
  values      CustomFieldValue[]

  @@unique([companyId, entity, fieldKey])
  @@index([companyId])
  @@index([entity])
}

model CustomFieldValue {
  id            String      @id @default(cuid())
  customFieldId String
  customField   CustomField @relation(fields: [customFieldId], references: [id], onDelete: Cascade)
  entityId      String      // id of the related record (client id, payable id, etc.)
  value         String?     @db.Text
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt

  @@unique([customFieldId, entityId])
  @@index([customFieldId])
  @@index([entityId])
}

// ====================== METAS / GOALS ======================

model Goal {
  id            String    @id @default(cuid())
  companyId     String
  company       Company   @relation("CompanyGoals", fields: [companyId], references: [id], onDelete: Cascade)
  title         String
  description   String?
  type          String    @default("receita") // receita, despesa, clientes, nfe, custom
  metric        String    @default("valor") // valor, quantidade, percentual
  targetValue   Float
  currentValue  Float     @default(0)
  period        String    // YYYY-MM or YYYY (monthly or yearly)
  status        String    @default("em_andamento") // em_andamento, atingida, nao_atingida
  startDate     DateTime?
  endDate       DateTime?
  color         String    @default("#2563eb")
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([companyId])
  @@index([period])
  @@index([type])
}

// ====================== COMISSÕES ======================

model Commission {
  id             String    @id @default(cuid())
  companyId      String
  company        Company   @relation("CompanyCommissions", fields: [companyId], references: [id], onDelete: Cascade)
  agentName      String    // seller / agent name
  agentId        String?   // optional link to a user or employee id
  referenceId    String?   // receivable or sale id
  referenceType  String?   // receivable, nfe, manual
  description    String?
  saleAmount     Float     @default(0)
  rate           Float     @default(0)  // percentage rate e.g. 5.0 = 5%
  amount         Float                  // calculated commission amount
  period         String                 // YYYY-MM
  status         String    @default("pendente") // pendente, aprovada, paga, cancelada
  paidAt         DateTime?
  notes          String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([companyId])
  @@index([period])
  @@index([agentName])
  @@index([status])
}

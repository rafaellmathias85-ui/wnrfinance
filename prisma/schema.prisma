generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id               String            @id @default(cuid())
  name             String?
  email            String            @unique
  emailVerified    DateTime?
  image            String?
  password         String?
  accounts         Account[]
  sessions         Session[]
  expenses         Expense[]
  incomes          Income[]
  savingsBoxes     SavingsBox[]
  creditCards      CreditCard[]
  investments      Investment[]
  alerts           Alert[]
  transactions     Transaction[]
  bankConnections  BankConnection[]
  bankTransactions BankTransaction[]
  role             String            @default("user")
  resetToken       String?
  resetTokenExpiry DateTime?
  totpSecret       String?
  totpEnabled      Boolean           @default(false)
  backupCodes      String?
  hasPF            Boolean           @default(true)
  hasPJ            Boolean           @default(false)
  defaultEnv       String            @default("pf") // pf or pj
  allowedEnvs      String            @default("pf") // "pf", "pj", "both"
  hideAmounts      Boolean           @default(false)
  aiStrategy       String            @default("failover") // failover, round-robin, weighted, least-latency
  activeCompanyId  String?
  activeCompany    Company?          @relation("ActiveCompany", fields: [activeCompanyId], references: [id], onDelete: SetNull)
  companies        UserCompany[]
  permissions          UserPermission[]
  approvalsRequested   FinancialApproval[] @relation("ApprovalRequester")
  approvalsToApprove   FinancialApproval[] @relation("ApprovalApprover")
  debtNegotiations     DebtNegotiation[]   @relation("UserDebtNegotiations")
  subscription         Subscription?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt

  @@index([resetToken])
  @@index([role])
  @@index([activeCompanyId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Expense {
  id                 String          @id @default(cuid())
  description        String
  amount             Float
  category           String
  date               DateTime
  status             String          @default("pendente")
  dueDay             Int?
  isRecurring        Boolean         @default(false)
  recurrenceType     String?
  isInstallment      Boolean         @default(false)
  installmentNumber  Int?
  totalInstallments  Int?
  installmentGroupId String?
  paymentMethod      String? // PIX, BOLETO, TRANSFERENCIA, CARTAO
  pixKey             String?
  boletoCode         String?
  transferBank       String?
  transferAgency     String?
  transferAccount    String?
  transferName       String?
  transferDoc        String?
  attachmentUrl      String?
  notes              String?
  userId             String
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId          String?
  bankConnectionId   String?
  bankConnection     BankConnection? @relation(fields: [bankConnectionId], references: [id], onDelete: SetNull)
  tags               ExpenseTag[]
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([userId])
  @@index([companyId])
  @@index([date])
  @@index([bankConnectionId])
  @@index([installmentGroupId])
}

model Income {
  id                 String          @id @default(cuid())
  description        String
  amount             Float
  date               DateTime
  type               String          @default("outros")
  status             String          @default("pendente")
  isRecurring        Boolean         @default(false)
  recurrenceType     String?
  isInstallment      Boolean         @default(false)
  installmentNumber  Int?
  totalInstallments  Int?
  installmentGroupId String?
  notes              String?
  userId             String
  user               User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId          String?
  bankConnectionId   String?
  bankConnection     BankConnection? @relation(fields: [bankConnectionId], references: [id], onDelete: SetNull)
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt

  @@index([userId])
  @@index([companyId])
  @@index([date])
  @@index([bankConnectionId])
  @@index([installmentGroupId])
}

model SavingsBox {
  id            String                @id @default(cuid())
  name          String
  goal          Float
  balance       Float                 @default(0)
  emoji         String                @default("🎯")
  targetDate    DateTime?
  category      String                @default("outros")
  isCompleted   Boolean               @default(false)
  userId        String
  user          User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  contributions SavingsContribution[]
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([userId])
}

model SavingsContribution {
  id     String     @id @default(cuid())
  boxId  String
  box    SavingsBox @relation(fields: [boxId], references: [id], onDelete: Cascade)
  amount Float
  type   String // deposit, withdrawal
  notes  String?
  date   DateTime   @default(now())
}

model CreditCard {
  id               String                  @id @default(cuid())
  userId           String
  user             User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId        String?
  company          Company?                @relation("CompanyCreditCards", fields: [companyId], references: [id], onDelete: Cascade)
  scope            String                  @default("PF")
  name             String
  bank             String
  lastFour         String
  cardLimit        Float
  closingDay       Int
  dueDay           Int
  color            String                  @default("#16A34A")
  isActive         Boolean                 @default(true)
  transactions     CreditCardTransaction[]
  bankConnectionId String?
  bankConnection   BankConnection?         @relation(fields: [bankConnectionId], references: [id], onDelete: SetNull)
  createdAt        DateTime                @default(now())
  updatedAt        DateTime                @updatedAt

  @@index([userId])
  @@index([companyId])
  @@index([bankConnectionId])
}

model CreditCardTransaction {
  id                 String     @id @default(cuid())
  cardId             String
  card               CreditCard @relation(fields: [cardId], references: [id], onDelete: Cascade)
  description        String
  amount             Float
  category           String?
  date               DateTime
  installments       Int        @default(1)
  currentInstallment Int        @default(1)
  isRecurring        Boolean    @default(false)
  createdAt          DateTime   @default(now())
}

model Investment {
  id               String          @id @default(cuid())
  userId           String
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  name             String
  type             String
  broker           String?
  amount           Float
  currentValue     Float
  purchaseDate     DateTime
  maturityDate     DateTime?
  notes            String?
  bankConnectionId String?
  bankConnection   BankConnection? @relation(fields: [bankConnectionId], references: [id], onDelete: SetNull)
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt

  @@index([userId])
  @@index([bankConnectionId])
}

model Alert {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String?  // null = PF, set = PJ
  type      String
  title     String
  message   String
  severity  String   @default("info")
  isRead    Boolean  @default(false)
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([companyId])
  @@index([createdAt])
}

model BankConnection {
  id               String            @id @default(cuid())
  userId           String            @map("user_id")
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId        String?           @map("empresa_id")
  company          Company?          @relation("CompanyBankConnections", fields: [companyId], references: [id], onDelete: Cascade)
  scope            String            @default("PF") // PF or PJ
  personType       String            @default("PF") @map("person_type") // PF or PJ
  provider         String // inter_pj, itau_pj, inter_pf_ofx, itau_pf_ofx, ofx, csv
  connectionId     String            @map("connection_id") // stable internal connection id
  connectionMode   String            @default("OFX") @map("connection_mode") // API, OFX, CSV, OPEN_FINANCE_FUTURE
  bankName         String            @map("bank_name")
  bankLogo         String?           @map("bank_logo")
  bankCode         String?           @map("bank_code") // INTER, ITAU or COMPE/ISPB fallback
  status           String            @default("PENDING_CONFIG") // ACTIVE, ERROR, DISABLED, PENDING_CONFIG
  lastSyncAt       DateTime?         @map("last_sync_at")
  tokenExpiresAt   DateTime?         @map("token_expires_at")
  accountType      String?           @map("account_type") // checking, savings, credit, investment
  accountNumber    String?           @map("account")
  accountDigit     String?           @map("account_digit")
  accountId        String?           @map("account_id")
  agency           String?
  openingBalance   Float?            @default(0) @map("opening_balance")
  currentBalance   Float?            @default(0) @map("current_balance")
  allowsPayments   Boolean           @default(false) @map("allows_payments")
  allowsReceipts   Boolean           @default(false) @map("allows_receipts")
  allowsTransfers  Boolean           @default(false) @map("allows_transfers")
  syncError        String?           @map("last_error")
  // Encrypted credentials (AES-256-GCM, never stored in plain text)
  ownerTaxIdEnc    String?           @map("owner_tax_id_encrypted")
  clientIdEnc      String?           @map("client_id_encrypted")
  clientSecretEnc  String?           @map("client_secret_encrypted")
  certificateEnc   String?           @map("certificate_encrypted")
  privateKeyEnc    String?           @map("private_key_encrypted")
  certPathEnc      String?           @map("cert_path_encrypted")
  certPasswordEnc  String?           @map("certificate_password_encrypted")
  accessTokenEnc   String?           @map("access_token_encrypted")
  refreshTokenEnc  String?           @map("refresh_token_encrypted")
  extraConfig      Json?             @map("extra_config") // bank-specific fields (convenio, cooperativa, etc.)
  expenses         Expense[]
  incomes          Income[]
  creditCards      CreditCard[]
  investments      Investment[]
  bankTransactions BankTransaction[] @relation("BankTxConn")
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")

  @@unique([provider, connectionId])
  @@index([userId])
  @@index([companyId])
  @@index([status])
  @@map("bank_connections")
}

model Transaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  externalId  String?  @unique
  provider    String?
  description String
  amount      Float
  type        String
  category    String?
  date        DateTime
  isRecurring Boolean  @default(false)
  notes       String?
  createdAt   DateTime @default(now())

  @@index([userId])
  @@index([date])
  @@index([externalId])
}

model BankTransaction {
  id               String          @id @default(cuid())
  userId           String          @map("user_id")
  user             User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId        String?         @map("empresa_id") // null = PF, set = PJ
  bankConnectionId String?         @map("bank_connection_id")
  bankConnection   BankConnection? @relation("BankTxConn", fields: [bankConnectionId], references: [id], onDelete: SetNull)
  personType       String          @default("PF") @map("person_type")
  bankCode         String?         @map("bank_code")
  accountId        String?         @map("account_id")
  externalId       String?         @map("external_id")
  transactionHash  String?         @map("transaction_hash") // sha256 dedup hash
  description      String
  amount           Float
  type             String          @map("direction") // credit, debit
  date             DateTime        @map("transaction_date")
  category         String?
  balanceAfter     Float?          @map("balance_after")
  documentNumber   String?         @map("document_number")
  payerName        String?         @map("counterparty_name")
  payerDocument    String?         @map("counterparty_tax_id")
  rawData          Json?           @map("raw_payload")
  status           String          @default("PENDING") @map("reconciliation_status") // PENDING, SUGGESTED, RECONCILED, IGNORED
  importBatchId    String?         @map("import_batch_id")
  reconciliation   Reconciliation? @relation("ReconBankTx")
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")

  @@unique([userId, externalId])
  @@unique([companyId, bankConnectionId, transactionHash])
  @@index([userId])
  @@index([companyId])
  @@index([date])
  @@index([bankConnectionId])
  @@index([status])
  @@index([importBatchId])
  @@index([transactionHash])
  @@map("bank_transactions")
}

model Reconciliation {
  id                String              @id @default(cuid())
  userId            String
  bankTransactionId String              @unique
  bankTransaction   BankTransaction     @relation("ReconBankTx", fields: [bankTransactionId], references: [id], onDelete: Cascade)
  internalType      String? // expense, income
  internalId        String?
  status            String              @default("PENDING") // PENDING, RECONCILED, DIVERGENT, NOT_FOUND, BANK_ONLY, IGNORED
  matchScore        Float?
  matchMethod       String? // auto, manual
  divergenceReason  String?
  resolvedAt        DateTime?
  resolvedBy        String?
  notes             String?
  logs              ReconciliationLog[]
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  @@index([userId])
  @@index([status])
}

model ReconciliationLog {
  id               String         @id @default(cuid())
  reconciliationId String
  reconciliation   Reconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  action           String // created, auto_matched, manual_matched, divergent, ignored, unmatched, updated
  previousStatus   String?
  newStatus        String
  details          Json?
  performedBy      String?
  createdAt        DateTime       @default(now())

  @@index([reconciliationId])
}

model Subscription {
  id                 String    @id @default(cuid())
  userId             String    @unique
  user               User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan               String    @default("free")
  status             String    @default("active")
  trialEndsAt        DateTime?
  currentPeriodStart DateTime?
  currentPeriodEnd   DateTime?
  canceledAt         DateTime?
  externalId         String?
  provider           String?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  @@index([status])
  @@index([plan])
}

// ====================== PJ MODELS ======================

model Company {
  id                 String                  @id @default(cuid())
  name               String // razão social
  tradeName          String? // nome fantasia
  cnpj               String                  @unique
  email              String?
  phone              String?
  address            String?
  segment            String?
  logoUrl            String?
  isPjFull           Boolean                 @default(false)
  pjFullPlan         String?
  pjFullActivatedAt  DateTime?
  features           Json?                   @default("{}")
  activeUsers        User[]                  @relation("ActiveCompany")
  users              UserCompany[]
  categories         BusinessCategory[]
  costCenters        CostCenter[]
  payables           AccountsPayable[]
  receivables        AccountsReceivable[]
  accounts           BusinessAccount[]
  investments        PJInvestment[]
  bankConnections    BankConnection[]        @relation("CompanyBankConnections")
  creditCards        CreditCard[]            @relation("CompanyCreditCards")
  negotiations       ReceivableNegotiation[]
  connections        CompanyConnection[]
  certificates       CompanyCertificate[]
  upgradeLogs        CompanyUpgradeLog[]
  clients            Client[]
  suppliers          Supplier[]
  nfes               NFe[]                   @relation("CompanyNFes")
  boletos            BoletoCharge[]          @relation("CompanyBoletos")
  taxRecords         TaxRecord[]
  serviceFiscalRules ServiceFiscalRule[]     @relation("CompanyServiceFiscalRules")
  purchaseOrders     PurchaseOrder[]         @relation("CompanyPurchaseOrders")
  contracts          Contract[]              @relation("CompanyContracts")
  collectionRules    CollectionRule[]
  financialApprovals FinancialApproval[]
  receivedNFes       ReceivedNFe[]           @relation("CompanyReceivedNFes")
  budgets            BudgetForecast[]        @relation("CompanyBudgets")
  crmAutomations     CRMAutomation[]         @relation("CompanyCRMAutomations")
  bpmFlows           BPMFlow[]               @relation("CompanyBPMFlows")
  customFields       CustomField[]           @relation("CompanyCustomFields")
  goals              Goal[]                  @relation("CompanyGoals")
  commissions        Commission[]            @relation("CompanyCommissions")
  debtNegotiations   DebtNegotiation[]       @relation("CompanyDebtNegotiations")
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt
}

model UserCompany {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  companyId String
  company   Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  role      String   @default("VIEWER") // OWNER, ADMIN, FINANCE, ACCOUNTANT, VIEWER
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, companyId])
  @@index([companyId])
}

model BusinessAccount {
  id                 String   @id @default(cuid())
  companyId          String
  company            Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  bankName           String
  accountType        String? // corrente, poupança
  agency             String?
  accountNumber      String?
  balance            Float    @default(0)
  externalProviderId String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([companyId])
}

model BusinessCategory {
  id          String               @id @default(cuid())
  companyId   String
  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  type        String               // receita, despesa, ambos
  color       String?
  // Plano de contas hierárquico
  parentId    String?
  parent      BusinessCategory?    @relation("CategoryHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children    BusinessCategory[]   @relation("CategoryHierarchy")
  code        String?              // ex: "1.1.1"
  isSystem    Boolean              @default(false)
  isActive    Boolean              @default(true)
  payables    AccountsPayable[]
  receivables AccountsReceivable[]
  contracts   Contract[]
  budgets     BudgetForecast[]     @relation("CategoryBudgets")
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt @default(now())

  @@unique([companyId, name])
  @@index([companyId])
  @@index([parentId])
}

model CostCenter {
  id          String               @id @default(cuid())
  companyId   String
  company     Company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name        String
  code        String?
  payables    AccountsPayable[]
  receivables AccountsReceivable[]
  contracts   Contract[]
  createdAt   DateTime             @default(now())

  @@unique([companyId, name])
  @@index([companyId])
}

model AccountsPayable {
  id                  String              @id @default(cuid())
  companyId           String
  company             Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  description         String
  supplierName        String?
  categoryId          String?
  category            BusinessCategory?   @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  costCenterId        String?
  costCenter          CostCenter?         @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  dueDate             DateTime
  amount              Float
  amountPaid          Float?
  paidAt              DateTime?
  status              String              @default("pendente")
  paymentMethod       String? // PIX, BOLETO, TRANSFERENCIA
  pixKey              String?
  boletoCode          String?
  transferBank        String?
  transferAgency      String?
  transferAccount     String?
  transferName        String?
  transferDoc         String?
  transferAccountType String?
  attachmentUrl       String?
  isRecurring         Boolean             @default(false)
  recurrenceType      String?
  recurrenceId        String?
  recurrence          Recurrence?         @relation("RecurrencePayables", fields: [recurrenceId], references: [id], onDelete: SetNull)
  launchType          String? // fornecedor, funcionario, impostos, transferencia, lucros
  notes               String?
  createdBy           String?
  tags                AccountPayableTag[]
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt

  @@index([companyId])
  @@index([dueDate])
  @@index([status])
  @@index([recurrenceId])
}

model AccountsReceivable {
  id             String                  @id @default(cuid())
  companyId      String
  company        Company                 @relation(fields: [companyId], references: [id], onDelete: Cascade)
  description    String
  customerName   String?
  customerDoc    String? // CPF/CNPJ do cliente para NF-e e Boleto
  customerEmail  String?
  categoryId     String?
  category       BusinessCategory?       @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  costCenterId   String?
  costCenter     CostCenter?             @relation(fields: [costCenterId], references: [id], onDelete: SetNull)
  dueDate        DateTime
  amount         Float
  amountReceived Float?
  receivedAt     DateTime?
  status         String                  @default("pendente")
  isRecurring    Boolean                 @default(false)
  recurrenceType String?
  recurrenceId   String?
  recurrence     Recurrence?             @relation("RecurrenceReceivables", fields: [recurrenceId], references: [id], onDelete: SetNull)
  notes          String?
  createdBy      String?
  // Origem do lançamento
  sourceType     String? // manual, sale, contract
  sourceId       String? // SalesOrder.id ou Contract.id
  billingPeriod  String? // YYYY-MM para faturamento recorrente
  launchType     String?                 // venda, contrato, aporte, outros
  // Automações
  autoNfe        Boolean                 @default(false)
  autoBoleto     Boolean                 @default(false)
  chargeType     String?                 @default("boleto_pix") // boleto, pix, boleto_pix, link
  fiscalRuleId   String?
  fiscalRule     ServiceFiscalRule?      @relation("ReceivableFiscalRule", fields: [fiscalRuleId], references: [id], onDelete: SetNull)
  tags           AccountReceivableTag[]
  negotiations   ReceivableNegotiation[]
  // Flags de geração automática
  generateBoleto Boolean                 @default(true)
  generatePix    Boolean                 @default(true)
  generateNfe    Boolean                 @default(true)
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([companyId])
  @@index([dueDate])
  @@index([status])
  @@index([recurrenceId])
  @@index([sourceId])
  @@index([sourceId, billingPeriod])
  @@index([fiscalRuleId])
}

model ReceivableNegotiation {
  id             String              @id @default(cuid())
  companyId      String
  company        Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  receivableId   String?
  receivable     AccountsReceivable? @relation(fields: [receivableId], references: [id], onDelete: SetNull)
  customerName   String
  customerDoc    String?
  contactName    String?
  contactPhone   String?
  contactEmail   String?
  originalAmount Float
  newAmount      Float
  newDueDate     DateTime
  installments   Int                 @default(1)
  interestRate   Float?              @default(0)
  discount       Float?              @default(0)
  status         String              @default("negociado") // negociado, pago, cancelado, perdido
  notes          String?
  nextContact    DateTime?
  createdBy      String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([companyId])
  @@index([receivableId])
  @@index([status])
}

// ====================== TAGS ======================

model Tag {
  id             String                 @id @default(cuid())
  name           String
  color          String                 @default("#3b82f6")
  description    String?
  scope          String                 @default("AMBOS") // PF, PJ, AMBOS
  isSystem       Boolean                @default(false)
  userId         String? // null = global/system tag
  companyId      String? // null = user-level tag
  payableTags    AccountPayableTag[]
  receivableTags AccountReceivableTag[]
  expenseTags    ExpenseTag[]
  createdAt      DateTime               @default(now())

  @@unique([name, userId, companyId])
}

model AccountPayableTag {
  id        String          @id @default(cuid())
  payableId String
  payable   AccountsPayable @relation(fields: [payableId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag             @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime        @default(now())

  @@unique([payableId, tagId])
}

model AccountReceivableTag {
  id           String             @id @default(cuid())
  receivableId String
  receivable   AccountsReceivable @relation(fields: [receivableId], references: [id], onDelete: Cascade)
  tagId        String
  tag          Tag                @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt    DateTime           @default(now())

  @@unique([receivableId, tagId])
}

model ExpenseTag {
  id        String   @id @default(cuid())
  expenseId String
  expense   Expense  @relation(fields: [expenseId], references: [id], onDelete: Cascade)
  tagId     String
  tag       Tag      @relation(fields: [tagId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([expenseId, tagId])
}

// ====================== PJ INVESTMENTS ======================

model PJInvestment {
  id              String    @id @default(cuid())
  companyId       String
  company         Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  institutionName String
  productName     String
  investmentType  String // CDB, LCI, LCA, Tesouro, Ações, FII, Fundos, Debêntures, Poupança, Outros
  amountInvested  Float
  currentValue    Float
  profitability   Float? // percentual
  applicationDate DateTime
  maturityDate    DateTime?
  liquidity       String? // Diária, D+1, D+30, No vencimento
  indexer         String? // CDI, IPCA, Selic, Pré-fixado
  riskLevel       String? // Conservador, Moderado, Arrojado
  accountId       String? // BusinessAccount reference
  status          String    @default("ativo") // ativo, resgatado, vencido
  notes           String?
  createdBy       String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([maturityDate])
}

// ====================== RECURRENCE ======================

model Recurrence {
  id                 String               @id @default(cuid())
  type               String // PAGAR, RECEBER
  frequency          String // MENSAL, QUINZENAL, SEMANAL, ANUAL, PERSONALIZADO
  customIntervalDays Int?
  startDate          DateTime
  endDate            DateTime?
  renewalMonths      Int?                 @default(12)
  autoRenew          Boolean              @default(false)
  status             String               @default("ATIVA") // ATIVA, PAUSADA, ENCERRADA, RENOVADA
  totalOccurrences   Int                  @default(0)
  generatedCount     Int                  @default(0)
  companyId          String?
  userId             String?
  payables           AccountsPayable[]    @relation("RecurrencePayables")
  receivables        AccountsReceivable[] @relation("RecurrenceReceivables")
  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt

  @@index([status])
}

// ====================== PJ RECONCILIATION ======================

model PJReconciliation {
  id               String                @id @default(cuid())
  companyId        String
  type             String // PAYABLE, RECEIVABLE
  accountId        String // AccountsPayable or AccountsReceivable ID
  bankConnectionId String? // BankConnection.id
  bankName         String? // display name e.g. "Itaú CC 0050212-2"
  importBatchId    String? // groups all records from the same upload
  bankReference    String?
  bankDate         DateTime?
  bankAmount       Float?
  status           String                @default("PENDING") // PENDING, RECONCILED, DIVERGENT, NOT_FOUND, BANK_ONLY, IGNORED, SCHEDULED
  matchMethod      String? // auto, manual
  divergenceNote   String?
  reconciledAt     DateTime?
  reconciledBy     String?
  notes            String?
  logs             PJReconciliationLog[]
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt

  @@index([companyId])
  @@index([status])
  @@index([accountId])
  @@index([importBatchId])
}

model PJReconciliationLog {
  id               String           @id @default(cuid())
  reconciliationId String
  reconciliation   PJReconciliation @relation(fields: [reconciliationId], references: [id], onDelete: Cascade)
  action           String
  previousStatus   String?
  newStatus        String
  details          Json?
  performedBy      String?
  createdAt        DateTime         @default(now())

  @@index([reconciliationId])
}

// ====================== AI PROVIDERS ======================

model AIProvider {
  id           String   @id @default(cuid())
  userId       String
  name         String // e.g. "OpenAI", "DeepSeek", "AbacusAI"
  model        String // e.g. "gpt-4.1-mini", "deepseek-chat"
  endpoint     String   @default("") // API endpoint URL (empty = use default for provider)
  apiKey       String   @default("") @db.Text // encrypted API key (empty = built-in)
  priority     Int      @default(1) // P1 = highest, P4 = lowest
  weight       Int      @default(100) // load balancing weight (1-100)
  capabilities String[] @default(["general"]) // general, fast, complex, creative
  isBuiltIn    Boolean  @default(false) // true = AbacusAI built-in, no key needed
  isActive     Boolean  @default(true)
  sortOrder    Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@index([userId, isActive])
  @@index([priority])
}

// ====================== AI ASSISTANT ======================

model AIConversation {
  id        String      @id @default(cuid())
  userId    String
  companyId String?
  env       String      @default("pf") // pf or pj
  title     String      @default("Nova conversa")
  messages  AIMessage[]
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  @@index([userId])
  @@index([companyId])
  @@index([env])
}

model AIMessage {
  id             String         @id @default(cuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String // user, assistant, system
  content        String         @db.Text
  createdAt      DateTime       @default(now())

  @@index([conversationId])
  @@index([createdAt])
}

// ====================== CONNECTIONS MODULE ======================

model CompanyConnection {
  id           String    @id @default(cuid())
  companyId    String
  company      Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  providerKey  String // ex: nfe_io, tecnospeed, gerencianet, banco_x, open_finance
  displayName  String
  category     String    @default("outros") // nfe, boleto, banco, investimento, cartao, pagamento, whatsapp, outros
  config       Json?     @default("{}")
  status       String    @default("pendente") // ok, atencao, erro, pendente
  lastHealthAt DateTime?
  lastError    String?   @db.Text
  isActive     Boolean   @default(true)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@index([companyId])
  @@index([companyId, category])
  @@index([status])
}

model CompanyCertificate {
  id         String    @id @default(cuid())
  companyId  String
  company    Company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  fileName   String
  thumbprint String?
  expiresAt  DateTime?
  cnpj       String?
  metadata   Json?     @default("{}")
  cloudPath  String? // path in cloud storage
  isActive   Boolean   @default(true)
  uploadedBy String?
  createdAt  DateTime  @default(now())

  @@index([companyId])
  @@index([expiresAt])
}

model CompanyUpgradeLog {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  previousState Json?
  newState      Json?
  changedBy     String?
  reason        String?  @db.Text
  createdAt     DateTime @default(now())

  @@index([companyId])
  @@index([createdAt])
}

// ====================== CLIENTS & SUPPLIERS ======================

model Client {
  id                      String              @id @default(cuid())
  companyId               String
  company                 Company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  name                    String
  document                String? // CPF or CNPJ (legado)
  email                   String?
  phone                   String?
  address                 String?
  city                    String?
  state                   String?
  notes                   String?             @db.Text
  isActive                Boolean             @default(true)
  // Dados fiscais e cadastrais expandidos
  countryOrigin           String?             @default("BR")
  tradeName               String?
  cnpj                    String?
  cpf                     String?
  clientType              String              @default("PJ") // PJ ou PF
  stateRegistration       String?
  stateRegistrationUF     String?
  municipalRegistration   String?
  activityBranch          String?
  simplesNacional         Boolean             @default(false)
  ignoreIMNfse            Boolean             @default(false)
  rating                  Int?                @default(3) // 1-5 estrelas
  // Faturamento por cliente
  billingDaysAntecipation Int?
  billingDay              Int?
  nfseEmissionMode        String?             @default("company") // company | on_billing | on_payment
  // Portal do cliente
  portalSupportEnabled    Boolean             @default(true)
  portalFinanceEnabled    Boolean             @default(true)
  // Relacionamentos
  portalToken             ClientPortalToken?
  addresses               ClientAddress[]
  contacts                ClientContact[]
  debtNegotiations        DebtNegotiation[]
  createdAt               DateTime            @default(now())
  updatedAt               DateTime            @updatedAt

  @@index([companyId])
  @@index([name])
}

model ClientAddress {
  id          String   @id @default(cuid())
  clientId    String
  client      Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  cep         String?
  logradouro  String?
  numero      String?
  complemento String?
  bairro      String?
  cidade      String?
  estado      String?
  isPrimary   Boolean  @default(false)
  createdAt   DateTime @default(now())

  @@index([clientId])
}

model ClientContact {
  id        String   @id @default(cuid())
  clientId  String
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  name      String
  email     String?
  phone     String?
  isBilling Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([clientId])
}

model ClientPortalToken {
  id        String   @id @default(cuid())
  clientId  String   @unique
  client    Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  companyId String
  token     String   @unique @default(cuid())
  isActive  Boolean  @default(true)
  expiresAt DateTime?
  createdAt DateTime @default(now())

  @@index([token])
  @@index([companyId])
}

model Supplier {
  id           String   @id @default(cuid())
  companyId    String?
  company      Company? @relation(fields: [companyId], references: [id], onDelete: Cascade)
  userId       String?
  name         String
  document     String? // CPF or CNPJ
  email        String?
  phone        String?
  address      String?
  city         String?
  state        String?
  notes        String?
  supplierType String   @default("supplier") // "supplier" | "employee"
  position     String? // cargo/função (para funcionários)
  salary       Float?  // salário (para funcionários)
  hiredAt      DateTime? // data de admissão
  isActive     Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([companyId])
  @@index([userId])
  @@index([name])
  @@index([companyId, supplierType])
}

// ====================== AI PROVIDER LOGS ======================

model AIProviderLog {
  id           String   @id @default(cuid())
  userId       String
  providerId   String // AIProvider id or 'default'
  providerName String
  model        String
  success      Boolean
  latencyMs    Int      @default(0)
  statusCode   Int      @default(0)
  isFailover   Boolean  @default(false) // true if this was NOT the first provider tried
  errorMsg     String?
  createdAt    DateTime @default(now())

  @@index([userId])
  @@index([providerId])
  @@index([createdAt])
  @@index([userId, providerId])
}

// ============================================================
// User Permissions (granular per-module/action permissions)
// ============================================================
model UserPermission {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  module    String // e.g. "financeiro", "cartoes", "investimentos", "metas", "alertas", "ia", "admin", "config"
  action    String // e.g. "view", "create", "edit", "delete", "export", "approve"
  allowed   Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, module, action])
  @@index([userId])
  @@index([module])
}

// ===== ESTOQUE =====
model Product {
  id           String          @id @default(cuid())
  companyId    String
  code         String?
  name         String
  description  String?
  category     String?
  unit         String          @default("UN")
  costPrice    Float           @default(0)
  salePrice    Float           @default(0)
  minStock     Float           @default(0)
  currentStock Float           @default(0)
  status       String          @default("active")
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  movements    StockMovement[]

  @@unique([companyId, code])
  @@index([companyId])
}

model Warehouse {
  id          String          @id @default(cuid())
  companyId   String
  name        String
  address     String?
  responsible String?
  status      String          @default("active")
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  movements   StockMovement[]

  @@index([companyId])
}

model StockMovement {
  id          String     @id @default(cuid())
  companyId   String
  productId   String
  product     Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouseId String?
  warehouse   Warehouse? @relation(fields: [warehouseId], references: [id])
  type        String // "entrada", "saida", "ajuste", "transferencia"
  quantity    Float
  unitCost    Float?
  totalCost   Float?
  reference   String?
  notes       String?
  createdBy   String?
  createdAt   DateTime   @default(now())

  @@index([companyId])
  @@index([productId])
}

// ===== VENDAS =====
model SalesOrder {
  id           String           @id @default(cuid())
  companyId    String
  number       String?
  type         String           @default("orcamento") // "orcamento", "ordem_servico", "venda"
  customerId   String?
  customerName String?
  sellerId     String?
  sellerName   String?
  status       String           @default("rascunho") // "rascunho","enviado","aprovado","rejeitado","concluido","cancelado"
  subtotal     Float            @default(0)
  discount     Float            @default(0)
  total        Float            @default(0)
  notes        String?
  validUntil   DateTime?
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  items        SalesOrderItem[]

  @@index([companyId])
}

model SalesOrderItem {
  id          String     @id @default(cuid())
  orderId     String
  order       SalesOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productName String
  quantity    Float      @default(1)
  unitPrice   Float      @default(0)
  discount    Float      @default(0)
  total       Float      @default(0)

  @@index([orderId])
}

model Seller {
  id         String   @id @default(cuid())
  companyId  String
  name       String
  email      String?
  phone      String?
  commission Float    @default(0) // percentage
  salesCount Int      @default(0)
  totalSales Float    @default(0)
  status     String   @default("active")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId])
}

// ===== CRM =====
model CRMFunnel {
  id            String           @id @default(cuid())
  companyId     String
  name          String
  position      Int              @default(0)
  color         String?
  createdAt     DateTime         @default(now())
  opportunities CRMOpportunity[]

  @@index([companyId])
}

model CRMLead {
  id         String   @id @default(cuid())
  companyId  String
  name       String
  company    String?
  email      String?
  phone      String?
  source     String? // "site","indicacao","telefone","email","rede_social"
  status     String   @default("novo") // "novo","contatado","qualificado","descartado"
  notes      String?
  assignedTo String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([companyId])
}

model CRMOpportunity {
  id            String        @id @default(cuid())
  companyId     String
  title         String
  company       String?
  value         Float         @default(0)
  funnelId      String?
  funnel        CRMFunnel?    @relation(fields: [funnelId], references: [id])
  status        String        @default("aberta") // "aberta","ganha","perdida"
  probability   Int           @default(50)
  assignedTo    String?
  contactName   String?
  contactEmail  String?
  lostReason    String?
  notes         String?
  expectedClose DateTime?
  closedAt      DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  activities    CRMActivity[]

  @@index([companyId])
  @@index([funnelId])
}

model CRMActivity {
  id            String          @id @default(cuid())
  companyId     String
  opportunityId String?
  opportunity   CRMOpportunity? @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  type          String // "ligacao","email","reuniao","tarefa","nota","call","meeting","task","followup","visit"
  title         String
  description   String?
  contactName   String?
  contactType   String? // crm, servicedesk
  dueDate       DateTime?
  status        String          @default("pending") // pending, done, cancelled
  completed     Boolean         @default(false)
  assignedTo    String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([companyId])
  @@index([opportunityId])
  @@index([contactType])
}

// ===== SERVICEDESK =====
model SDTicket {
  id             String            @id @default(cuid())
  companyId      String
  number         Int               @default(autoincrement())
  subject        String
  description    String?           @db.Text
  requester      String?
  requesterEmail String?
  agentId        String?
  agentName      String?
  groupId        String?
  typeId         String?
  priority       String            @default("media") // "baixa","media","alta","critica"
  status         String            @default("aberto") // "aberto","em_atendimento","pendente","resolvido","fechado"
  category       String?
  tags           String?
  resolution     String?           @db.Text
  slaDeadline    DateTime?
  resolvedAt     DateTime?
  closedAt       DateTime?
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  comments       SDTicketComment[]

  @@index([companyId])
  @@index([status])
  @@index([priority])
  @@index([agentId])
}

model SDTicketComment {
  id         String   @id @default(cuid())
  ticketId   String
  ticket     SDTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  authorName String
  authorId   String?
  isInternal Boolean  @default(false)
  body       String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([ticketId])
}

model SDGroup {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  description String?
  createdAt   DateTime @default(now())

  @@index([companyId])
}

model SDAgent {
  id        String   @id @default(cuid())
  companyId String
  name      String
  email     String?
  groupId   String?
  status    String   @default("active")
  createdAt DateTime @default(now())

  @@index([companyId])
}

// ===== BPM =====
model BPMProcess {
  id          String        @id @default(cuid())
  companyId   String
  name        String
  description String?
  department  String?
  stepsJson   String? // JSON array of step definitions
  status      String        @default("active")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  instances   BPMInstance[]

  @@index([companyId])
}

model BPMInstance {
  id          String     @id @default(cuid())
  companyId   String
  processId   String
  process     BPMProcess @relation(fields: [processId], references: [id], onDelete: Cascade)
  requester   String?
  currentStep String?
  status      String     @default("em_andamento") // "em_andamento","finalizado","cancelado"
  priority    String     @default("normal")
  data        String? // JSON data for the instance
  startedAt   DateTime   @default(now())
  finishedAt  DateTime?

  @@index([companyId])
  @@index([processId])
}

model BPMDepartment {
  id          String   @id @default(cuid())
  companyId   String
  name        String
  responsible String?
  status      String   @default("active")
  createdAt   DateTime @default(now())

  @@index([companyId])
}


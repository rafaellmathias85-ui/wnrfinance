# ====================================
# WNR FINANCE - Variáveis de Ambiente
# Copie este arquivo para .env e preencha todos os valores
# NUNCA commite o arquivo .env — ele está no .gitignore
# ====================================

# ─── APLICAÇÃO ─────────────────────────────────────────────────
NODE_ENV=production
NEXTAUTH_URL=https://seudominio.com
NEXTAUTH_SECRET=gere_com_openssl_rand_base64_32

# Segredos internos para comunicação entre serviços
INTERNAL_API_SECRET=gere_com_openssl_rand_base64_32
CRON_SECRET=gere_com_openssl_rand_base64_32

# ─── BANCO DE DADOS ────────────────────────────────────────────
# Usado pelo docker-compose automaticamente:
DB_USER=wnr_user
DB_PASSWORD=TROQUE_POR_UMA_SENHA_FORTE
# Para banco externo, descomente:
# DATABASE_URL=postgresql://usuario:senha@host:5432/database?connect_timeout=15&connection_limit=10&pool_timeout=20

# ─── SEGURANÇA — CRIPTOGRAFIA ──────────────────────────────────
# OBRIGATÓRIO — usada para criptografar senhas SMTP, tokens WhatsApp e credenciais
# Gere com: openssl rand -base64 32
ENCRYPTION_KEY=sua_chave_aqui_32_bytes_base64

# ─── AUTH PROVIDERS ────────────────────────────────────────────
# Google OAuth2 (console.cloud.google.com)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ─── EMAIL SMTP (módulo configurável via painel) ───────────────
# Estas vars são usadas como SMTP padrão do sistema (alertas, recuperação de senha)
# O usuário pode configurar SMTPs adicionais via /configuracoes/smtp
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=seu@email.com
SMTP_PASS=sua_senha_de_app_16_digitos
SMTP_FROM=noreply@seudominio.com

# ─── WHATSAPP BUSINESS (Meta Cloud API) ────────────────────────
# Configure via /configuracoes/whatsapp após cadastro em business.facebook.com
# Estes valores ficam armazenados no banco (criptografados), não no .env
# Deixe em branco — configure pelo painel
# META_WHATSAPP_PHONE_NUMBER_ID=
# META_WHATSAPP_BUSINESS_ACCOUNT_ID=
# META_WHATSAPP_ACCESS_TOKEN=
# META_WHATSAPP_WEBHOOK_SECRET=

# ─── NOTA FISCAL — FOCUS NFe ──────────────────────────────────
# Cadastre-se em focusnfe.com.br / Configure via /pj/conexoes
FOCUSNFE_TOKEN=
FOCUSNFE_SANDBOX=true

# ─── BOLETO & PIX — ASAAS ─────────────────────────────────────
# Cadastre-se em asaas.com / Configure via /pj/conexoes
# Webhook URL: https://seudominio.com/api/webhooks/asaas
ASAAS_API_KEY=
ASAAS_SANDBOX=true
# OBRIGATÓRIO EM PRODUÇÃO: token de autenticação do webhook.
# Gere um valor aleatório (openssl rand -hex 32) e cadastre o MESMO valor
# no painel Asaas (Integrações → Webhooks → Token de autenticação).
# Sem este token, webhooks de pagamento são REJEITADOS em produção (fail-closed).
ASAAS_WEBHOOK_TOKEN=

# ─── SEGURANÇA DE WEBHOOKS (fail-closed em produção) ───────────
# Focus NFe: assinatura HMAC-SHA1 (x-hub-signature)
FOCUSNFE_WEBHOOK_SECRET=
# Pluggy: assinatura HMAC-SHA256 (x-pluggy-signature) — se Pluggy ativo
# PLUGGY_WEBHOOK_SECRET=
# WhatsApp: token (Evolution API) ou app secret (Meta Cloud API) — opt-in
# WHATSAPP_WEBHOOK_TOKEN=
# WHATSAPP_APP_SECRET=
# Escape hatch TEMPORÁRIO (aceita webhooks sem auth, com log crítico).
# NUNCA deixe true em produção de forma permanente.
# WEBHOOK_ALLOW_UNAUTHENTICATED=false

# ─── INTEGRAÇÃO BANCÁRIA MVP: INTER / ITAÚ ─────────────────────
# Não usa Pluggy, Belvo, Klavi ou agregador pago neste MVP.
# PF usa importação OFX/CSV. PJ pode usar API oficial quando habilitada pelo banco.
BANK_SYNC_ENABLED=true
BANK_SYNC_INTERVAL_MINUTES=240
BANK_SYNC_LOOKBACK_DAYS=7

INTER_PJ_BASE_URL=https://cdpj.partners.bancointer.com.br
INTER_PJ_TOKEN_URL=https://cdpj.partners.bancointer.com.br/oauth/v2/token

ITAU_PJ_BASE_URL=
ITAU_PJ_TOKEN_URL=

BANK_REQUEST_TIMEOUT_MS=30000
BANK_RETRY_ATTEMPTS=3

# ─── ITAÚ BOLETO mTLS (OAuth2 + certificado digital) ──────────────
# Credenciais: ITAU/certs/ (gitignored — copiar manualmente para o servidor)
# Client ID (não-secreto, fixo por empresa)
ITAU_CLIENT_ID=371dd04c-8b91-4cb5-8f37-7683aa826a7e
# Client Secret: obtido na Etapa 2 do ITAU/SETUP.md (após envio do CSR)
ITAU_CLIENT_SECRET=<secret_retornado_pelo_itau>
# Caminhos dos certs relativo à raiz do projeto (os defaults já apontam para ITAU/certs/)
ITAU_CERT_PATH=ITAU/certs/certificado.crt
ITAU_KEY_PATH=ITAU/certs/ARQUIVO_CHAVE_PRIVADA.key
# Dados bancários: id_beneficiario = Agência(4) + "00" + Conta(5) + DAC(1)
ITAU_ID_BENEFICIARIO=<agencia4><00><conta5><dac1>
ITAU_AGENCIA=<4_digitos>
ITAU_CONTA=<5_digitos>
ITAU_DAC=<1_digito>
ITAU_CARTEIRA=109
# 'validacao' = teste (não registra boleto); 'efetivacao' = produção
ITAU_ETAPA_PROCESSO=efetivacao
# Webhook (credenciais que VOCÊ cria — o Itaú usa para autenticar no WnrFinance)
ITAU_WEBHOOK_CLIENT_ID=<uuid_gerado_por_voce>
ITAU_WEBHOOK_CLIENT_SECRET=<secret_gerado_por_voce>
ITAU_WEBHOOK_URL=https://seudominio.com.br/api/itau/webhook/boletos
ITAU_WEBHOOK_AUTH_URL=https://seudominio.com.br/api/itau/auth

# ─── IA / ASSISTENTE ──────────────────────────────────────────
# Claude (Anthropic) — recomendado para categorização de lançamentos
ANTHROPIC_API_KEY=sk-ant-...
# OpenAI (alternativa)
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1

# ─── ARMAZENAMENTO S3 (certificados digitais e anexos) ────────
# S3_BUCKET=
# S3_REGION=us-east-1
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_ENDPOINT=   # deixe em branco para AWS padrão

# ─── MONITORAMENTO (opcional) ────────────────────────────────
# SENTRY_DSN=
# LOGTAIL_SOURCE_TOKEN=
